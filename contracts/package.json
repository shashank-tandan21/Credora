{
  "name": "credora-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Solidity contracts, deployment scripts, and tests for the REBOUND/Credora academic micro-lending prototype.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test mocha",
    "coverage": "hardhat test mocha --coverage",
    "typecheck": "tsc --noEmit",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost && hardhat run scripts/export-artifacts.ts",
    "smoke:local": "hardhat run scripts/smoke.ts --network localhost",
    "export": "hardhat run scripts/export-artifacts.ts",
    "deploy:sepolia": "node scripts/guarded-sepolia-deploy.mjs",
    "smoke:sepolia": "hardhat run scripts/smoke.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.ts --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-verify": "3.1.4",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.2",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}
