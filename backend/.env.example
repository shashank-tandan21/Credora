APP_NAME=REBOUND API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://rebound:change-me@localhost:5432/rebound
SEPOLIA_RPC_URL=
CHAIN_ID=11155111
CHAIN_CONFIRMATIONS=1
CHAIN_RPC_TIMEOUT_SECONDS=10
JWT_SECRET=replace-this-in-development
AUTH_NONCE_EXPIRY_SECONDS=600

# Contract addresses. Leave empty in demo mode. For a local Hardhat chain copy them from
# ../contracts/deployments/localhost.env.example and set SEPOLIA_RPC_URL=http://127.0.0.1:8545
# and CHAIN_ID=31337. Required when DEMO_MODE=false.
MOCK_USDC_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
CREDIT_SCORE_REGISTRY_ADDRESS=
LENDING_POOL_ADDRESS=
LOAN_MANAGER_ADDRESS=
RECOVERY_MANAGER_ADDRESS=
DISPUTE_MANAGER_ADDRESS=
