# Backend base URL used by the Vite dev proxy for /api requests.
VITE_API_URL=http://localhost:8000

# 11155111 = Sepolia, 31337 = local Hardhat node. Any other value falls back to Sepolia.
VITE_CHAIN_ID=11155111
# true: start in Demo Mode (simulated, no wallet). false: start in on-chain mode.
VITE_DEMO_MODE=true

# Optional JSON-RPC endpoint for reads. Bundled into the browser, so use a public or
# domain-restricted key. Defaults to the chain's public RPC (http://127.0.0.1:8545 locally).
VITE_RPC_URL=
# Optional confirmation depth (default 2 on Sepolia, 1 locally) and receipt timeout (ms).
VITE_CONFIRMATIONS=
VITE_TX_TIMEOUT_MS=

# Contract addresses. Required for Sepolia (copy from contracts/deployments/sepolia.json).
# On chain 31337 they default to the deterministic local deployment when left empty.
VITE_MOCK_USDC_ADDRESS=
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_CREDIT_SCORE_REGISTRY_ADDRESS=
VITE_LENDING_POOL_ADDRESS=
VITE_LOAN_MANAGER_ADDRESS=
VITE_RECOVERY_MANAGER_ADDRESS=
VITE_DISPUTE_MANAGER_ADDRESS=
